# Copy to .env.local and fill in. Keys stay server-side; the browser never sees them.

# Narrator (M4): Claude writes each line
ANTHROPIC_API_KEY=

# Narrator judge (M4): Jev (TypeSafe AI) via OpenRouter picks the event and checks the line.
# Give the key a spending limit.
OPENROUTER_API_KEY=

# Voice (M4) and design comp generation
ELEVENLABS_API_KEY=
# Your ElevenLabs voice ID. Not committed.
ELEVENLABS_VOICE_ID=

# Engine device: auto | cpu | mps | cuda
SPIKECAST_DEVICE=auto

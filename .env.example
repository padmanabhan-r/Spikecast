# Copy to .env.local and fill in. Keys stay server-side; the browser never sees them.

# Jev (TypeSafe AI), through OpenRouter: chooses the fly's actions and reads spoken commands.
# Without it, the coded rules drive the fly. Give the key a spending limit.
OPENROUTER_API_KEY=

# Claude writes the maze run's commentary. Optional: with no Anthropic key, the OpenRouter
# key above is used for this too.
ANTHROPIC_API_KEY=

# ElevenLabs: the narration voice, and speech-to-text for spoken commands.
ELEVENLABS_API_KEY=
# Optional: used only if config/narrator.yaml names no voice.
ELEVENLABS_VOICE_ID=

# Engine device: auto | cpu | mps | cuda
SPIKECAST_DEVICE=auto
